# Copy this file to .env before running `docker compose up`.
# Never commit the real .env file.

# --- Application ---------------------------------------------------------
APP_ENV=development
# Host port the API is published on (inside the container it is always 8080).
APP_PORT=8090

# --- Database ------------------------------------------------------------
# Inside Docker the backend reaches PostgreSQL via the compose service name
# "postgres" (NOT localhost).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=helpic
# Host port for PostgreSQL (5435 avoids clashing with a local Postgres on 5432).
POSTGRES_PORT=5435
DATABASE_URL=postgres://postgres:postgres@postgres:5432/helpic?sslmode=disable

# --- Auth / JWT ----------------------------------------------------------
# A sign-in is a session: a short-lived access token (JWT) and a refresh token
# that is swapped for a new one on every refresh. JWT_EXPIRATION is how long
# an access token lasts; REFRESH_EXPIRATION how long a session lasts unused.
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=15m
REFRESH_EXPIRATION=720h

# --- Cookies -------------------------------------------------------------
# COOKIE_SECURE=false and SameSite=lax work for http://localhost development.
# In production use COOKIE_SECURE=true (HTTPS) and, if the frontend is on a
# different site, COOKIE_SAME_SITE=none.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_NAME=auth_token
COOKIE_PATH=/
# The refresh token's cookie is only sent to the auth endpoints.
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth

# --- CORS ----------------------------------------------------------------
# Origin of the frontend (it runs in its own container, see ../frontend).
CORS_ORIGIN=http://localhost:5180

# Where the frontend lives, for links sent outside the app (Telegram).
# Defaults to CORS_ORIGIN.
# APP_URL=https://app.helpic.example

# --- Telegram --------------------------------------------------------------
# Notifications in Telegram. Create a bot with @BotFather and put its token
# here; leave it empty to keep Telegram off. The bot reads its messages by
# long polling, so it works without a public URL. "Open in Helpic" buttons
# are left out while APP_URL is localhost (Telegram refuses them).
# TELEGRAM_BOT_TOKEN=

# --- Report PDFs ---------------------------------------------------------
# PDFs are printed by headless Chromium; the Docker image sets CHROME_PATH.
# Outside Docker leave it empty to auto-detect Chrome/Chromium.
# CHROME_PATH=/usr/bin/chromium-browser

# --- Attachments -----------------------------------------------------------
# Task attachments are stored on disk; the Docker image keeps them in a volume.
# UPLOADS_DIR=uploads
# MAX_UPLOAD_MB=25

# --- API docs --------------------------------------------------------------
# Swagger UI at /api/docs: on by default outside production.
# SWAGGER_ENABLED=true
